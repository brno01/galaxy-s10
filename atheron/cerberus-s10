#!/usr/bin/env python3
"""cerberus-s10: monitor + guardian for the Galaxy S10 plugged into the atheron USB port.

Every S10_INTERVAL seconds (default 30) it makes sure the (loopback-only) adb server
is up, lists the devices, collects battery / wakefulness / Wi-Fi, and, when the S10
is 'device', enforces (read first, write only on drift) the settings that keep the
three access paths alive (USB, wireless adb, droidVNC-NG over Termux sshd). It then
probes each path and atomically writes /run/cerberus-s10/estado.json. Repairs and
path up/down transitions go to stderr (journald); secrets never do. Runs as a
non-root user: everything on the phone goes through `adb shell` (uid shell).
Stdlib only. Decisions and parsing are pure so they are tested with fixtures.
"""
import json
import os
import re
import socket
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from datetime import datetime, timezone

SAMSUNG_MODEL_PREFIX = "SM_"
STATUS = {1: "unknown", 2: "charging", 3: "discharging", 4: "not_charging", 5: "full"}
HEALTH = {1: "unknown", 2: "good", 3: "overheat", 4: "dead", 5: "over_voltage",
          6: "failure", 7: "cold"}
KNOWN_STATES = ("device", "unauthorized", "offline")


# ---------------------------------------------------------------- parsing (pure)
def parse_devices(text):
    """Parse `adb devices -l` into [{serial, state, model}]."""
    out = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith(("List of devices", "*")):
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        model = ""
        for tok in parts[2:]:
            if tok.startswith("model:"):
                model = tok[6:]
        out.append({"serial": parts[0], "state": parts[1], "model": model})
    return out


def select_device(devices, serial=None):
    """Return the S10 entry, or None. Configured serial wins; otherwise the
    single device, otherwise the single Samsung (model SM_*) one."""
    if serial:
        for d in devices:
            if d["serial"] == serial:
                return d
        return None
    if len(devices) == 1:
        return devices[0]
    sam = [d for d in devices if d["model"].startswith(SAMSUNG_MODEL_PREFIX)]
    return sam[0] if len(sam) == 1 else None


def parse_battery(text):
    """Parse `dumpsys battery`. Returns dict or None if no level was found."""
    kv = {}
    for line in text.splitlines():
        if ":" in line:
            k, _, v = line.partition(":")
            kv[k.strip()] = v.strip()

    def num(key):
        try:
            return int(kv[key])
        except (KeyError, ValueError):
            return None

    level = num("level")
    if level is None:
        return None
    scale = num("scale") or 100
    temp = num("temperature")
    plugged = [name for key, name in (("AC powered", "ac"), ("USB powered", "usb"),
                                      ("Wireless powered", "wireless"),
                                      ("Dock powered", "dock"))
               if kv.get(key) == "true"]
    status = num("status")
    health = num("health")
    return {
        "nivel": round(level * 100 / scale),
        "temperatura_c": None if temp is None else temp / 10.0,
        "status": STATUS.get(status, "unknown"),
        "plugado": plugged,
        "saude": HEALTH.get(health, "unknown"),
        "tensao_mv": num("voltage"),
    }


def parse_wakefulness(text):
    m = re.search(r"mWakefulness=(\w+)", text)
    return m.group(1) if m else None


def parse_wifi(text):
    """Parse `dumpsys wifi`: enabled flag and whether an SSID is associated."""
    m = re.search(r"Wi-Fi is (enabled|disabled)", text)
    if not m:
        return None
    conectado = False
    s = re.search(r'mWifiInfo SSID: ("?)([^,"]*)\1,', text)
    if s and "<unknown ssid>" not in s.group(2) and s.group(2):
        conectado = True
    return {"ligado": m.group(1) == "enabled", "conectado": conectado}


# ---------------------------------------------------------------- state machine
class Alerts:
    """Turns successive snapshots into de-duplicated warning messages."""

    def __init__(self, temp_max=45.0, full_hours=24.0, repeat_s=3600.0):
        self.temp_max = temp_max
        self.full_s = full_hours * 3600
        self.repeat_s = repeat_s
        self.last_estado = None
        self.last_warn = {}   # key -> epoch of last emitted warning
        self.full_since = None

    def _due(self, key, now):
        last = self.last_warn.get(key)
        if last is None or now - last >= self.repeat_s:
            self.last_warn[key] = now
            return True
        return False

    def evaluate(self, snap, now):
        msgs = []
        estado = snap["estado"]
        if estado != "device":
            self.full_since = None
            if self._due("estado", now) or estado != self.last_estado:
                self.last_warn["estado"] = now
                msgs.append("S10 %s (not usable over adb)" % estado)
        else:
            self.last_warn.pop("estado", None)
            if self.last_estado not in (None, "device"):
                msgs.append("S10 back to 'device'")
        self.last_estado = estado

        bat = snap.get("bateria")
        if estado == "device" and bat:
            t = bat.get("temperatura_c")
            if t is not None and t >= self.temp_max:
                if self._due("temp", now):
                    msgs.append("S10 temperature %.1f C >= %.0f C" % (t, self.temp_max))
            else:
                self.last_warn.pop("temp", None)
            if bat["nivel"] >= 100:
                if self.full_since is None:
                    self.full_since = now
                if now - self.full_since >= self.full_s and self._due("full", now):
                    msgs.append("S10 at 100%% for >%dh: battery protection probably off"
                                % (self.full_s // 3600))
            else:
                self.full_since = None
                self.last_warn.pop("full", None)
        return msgs


# ---------------------------------------------------------------- IO
def write_atomic(path, data, mode=0o644):
    """Write JSON to `path` atomically (tmp file in same dir + fsync + rename)."""
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(prefix=".estado-", dir=d)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


MAX_OUT = 1 << 20      # cap on captured stdout (L3)
MAX_XML = 512 << 10    # cap on a uiautomator dump


def default_run(cmd, timeout=15, input_text=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=input_text,
                           errors="replace")
        return p.returncode, p.stdout[:MAX_OUT]
    except (OSError, subprocess.TimeoutExpired):
        return 255, ""


def collect(run, adb="adb", serial=None, now=None, server_args=()):
    """Build the estado.json snapshot. `run(cmd)->(rc, stdout)` is injectable."""
    now = time.time() if now is None else now
    snap = {
        "timestamp": datetime.fromtimestamp(now, timezone.utc).isoformat(timespec="seconds"),
        "epoch": int(now),
        "conectado": False,
        "estado": "ausente",
        "serial": None,
        "bateria": None,
        "tela": None,
        "wifi": None,
    }
    rc, _ = run([adb] + list(server_args) + ["start-server"])  # no-op if running; unix socket only (no TCP :5037)
    rc, out = run([adb, "devices", "-l"])
    dev = select_device(parse_devices(out), serial) if rc == 0 else None
    if dev is None:
        return snap
    snap["serial"] = dev["serial"]
    snap["estado"] = dev["state"] if dev["state"] in KNOWN_STATES else "offline"
    if dev["state"] != "device":
        return snap
    snap["conectado"] = True
    sh = [adb, "-s", dev["serial"], "shell"]
    snap["bateria"] = parse_battery(run(sh + ["dumpsys", "battery"])[1])
    snap["tela"] = parse_wakefulness(run(sh + ["dumpsys", "power"])[1])
    snap["wifi"] = parse_wifi(run(sh + ["dumpsys", "wifi"])[1])
    return snap


# ---------------------------------------------------------------- guardian: parsing (pure)
PKG_TAILSCALE = "com.tailscale.ipn"
PKG_TERMUX = "com.termux"
PKG_TERMUX_BOOT = "com.termux.boot"
PKG_VNC = "net.christianbeier.droidvnc_ng"
PKG_SHIZUKU = "moe.shizuku.privileged.api"
VNC_PERMS = ("android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.READ_EXTERNAL_STORAGE")
WIFI_CONFIRM_FOCUS = "com.android.systemui/com.android.systemui.wifi.WifiDebuggingActivity"
UI_DUMP = "/data/local/tmp/cerberus-ui.xml"   # shell-owned, not world-writable like /sdcard
SYSTEMUI_PKG = "com.android.systemui"
VNC_TOGGLE_ID = PKG_VNC + ":id/toggle"
VNC_MAIN_PREFIX = PKG_VNC + "/"
TERMUX_ACTIVITY = "com.termux/.app.TermuxActivity"
START_LABELS = ("começar", "comecar", "start")
SHIZUKU_START = ("d=$(dirname $(pm path %s | cut -d: -f2)); $d/lib/arm64/libshizuku.so" % PKG_SHIZUKU)
IDLE_WHITELIST = (PKG_TAILSCALE, PKG_TERMUX, PKG_TERMUX_BOOT, PKG_VNC)
VNC_SERVICE = PKG_VNC + "/.MainService"
VNC_INPUT_SERVICE = PKG_VNC + "/.InputService"
LOOPBACK = ("127.0.0.1", "[::1]", "::1")
KEY_RE = re.compile(r"^[A-Za-z0-9._~-]{4,128}$")
PASS_RE = re.compile(r"^[A-Za-z0-9]{8}$")          # VNC authentication only uses 8 characters
COMPONENT_RE = re.compile(r"^[A-Za-z0-9_.]+/[A-Za-z0-9_.$]+$")


def parse_setting(text):
    """`settings get`: returns the value, "" when unset ('null'/empty)."""
    lines = [ln.strip() for ln in text.strip().splitlines() if ln.strip()]
    v = lines[-1] if lines else ""
    return "" if v == "null" else v


def parse_wifi_status(text):
    """`cmd wifi status`: True/False, None if unrecognised."""
    m = re.search(r"Wifi is (enabled|disabled)", text, re.I)
    return None if not m else m.group(1).lower() == "enabled"


def parse_pid(text):
    """`pidof`: True when at least one pid was printed."""
    return bool(re.search(r"^\d+(\s+\d+)*\s*$", text.strip()))


def parse_tls_port(text):
    """`getprop service.adb.tls.port`: port or None (empty/0 = wireless debugging off)."""
    try:
        p = int(text.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return None
    return p if 0 < p < 65536 else None


def parse_wifi_ip(text):
    """`ip -f inet addr show wlan0`: first IPv4 address or None."""
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)/", text)
    return m.group(1) if m else None


def parse_listening(text):
    """`ss -ltn` -> {port: set(local addresses)}."""
    out = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 5 or parts[0] != "LISTEN":
            continue
        addr, _, port = parts[3].rpartition(":")
        if port.isdigit():
            out.setdefault(int(port), set()).add(addr)
    return out


def parse_mdns_services(text, serial):
    """`adb mdns services` -> [(ip, port)] of the S10's wireless-debugging service
    (`adb-<serial>-<suffix>  _adb-tls-connect._tcp  <ip>:<port>`); other devices are ignored."""
    out = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 3 or "_adb-tls-connect" not in parts[1]:
            continue
        if serial and not parts[0].startswith("adb-%s-" % serial):
            continue
        m = re.match(r"^(\d+\.\d+\.\d+\.\d+):(\d+)$", parts[2])
        if m:
            out.append((m.group(1), int(m.group(2))))
    return out


def parse_avahi_tls(text, serial):
    """`avahi-browse -rpt _adb-tls-connect._tcp` (resolved lines start with '=') -> [(ip, port)]."""
    out = []
    for line in text.splitlines():
        f = line.split(";")
        if len(f) < 9 or f[0] != "=" or f[2] != "IPv4":
            continue
        if serial and not f[3].startswith("adb-%s-" % serial):
            continue
        if f[8].isdigit():
            out.append((f[7], int(f[8])))
    return out


def parse_logcat_tls_port(text):
    """Last `Received tls port=N` in a logcat dump (adbd logs it every time wireless debugging is
    enabled; the property is empty on this One UI build). Only 1024-65535 is accepted."""
    ports = [int(p) for p in re.findall(r"Received tls port=(\d+)", text)]
    ports = [p for p in ports if 1024 <= p <= 65535]
    return ports[-1] if ports else None


def parse_whitelist(text, pkg):
    """`dumpsys deviceidle whitelist`: lines look like `user,<pkg>,<uid>`."""
    return any(("," + pkg + ",") in (ln.strip() + ",") for ln in text.splitlines())


def parse_appop(text, op):
    m = re.search(r"\b%s: (\w+)" % re.escape(op), text)
    return m.group(1) if m else None


def parse_resolve_activity(text):
    """`cmd package resolve-activity --brief`: the last `pkg/.Activity` line."""
    comps = [ln.strip() for ln in text.splitlines() if COMPONENT_RE.match(ln.strip())]
    return comps[-1] if comps else None


def has_a11y_service(current, pkg):
    return any(s.split("/")[0] == pkg for s in current.split(":") if s)


def merge_a11y(current, service):
    """Append `service` to the colon-separated list without clobbering others."""
    if has_a11y_service(current, service.split("/")[0]):
        return current
    return service if not current else current + ":" + service


def parse_focus(text):
    """`dumpsys window | grep mCurrentFocus` (+ `dumpsys activity activities | grep mResumedActivity`) -> 'pkg/Activity'
    or None. Right after a reboot the window focus can be null while the dialog is the resumed activity (seen live with
    WifiDebuggingActivity), so the resumed activity is the fallback; a short '.Name' is expanded with the package."""
    m = re.search(r"mCurrentFocus=Window\{\S+ \S+ ([\w.$]+/[\w.$]+)\}", text)
    if m:
        return m.group(1)
    m = re.search(r"mResumedActivity: ActivityRecord\{\S+ \S+ ([\w.$]+)/([\w.$]+)", text)
    if m:
        pkg, act = m.groups()
        return pkg + "/" + (pkg + act if act.startswith(".") else act)
    return None


def parse_ui_nodes(xml_text, package=None):
    """`uiautomator dump` XML -> {resource-id: {"checked", "text", "package", "bounds"}}.
    With `package`, only nodes of that package count. An id that appears more than once among the
    considered nodes is ambiguous and dropped (another app could spoof a button). Oversized or
    DTD/entity-bearing XML is refused."""
    if len(xml_text) > MAX_XML or "<!DOCTYPE" in xml_text or "<!ENTITY" in xml_text:
        return {}
    try:
        root = ET.fromstring(xml_text.strip())
    except ET.ParseError:
        return {}
    seen, out = {}, {}
    for n in root.iter("node"):
        rid = n.get("resource-id")
        m = re.match(r"\[(\d+),(\d+)\]\[(\d+),(\d+)\]$", n.get("bounds", ""))
        if not rid or not m or (package and n.get("package") != package):
            continue
        seen[rid] = seen.get(rid, 0) + 1
        out[rid] = {"checked": n.get("checked") == "true", "text": n.get("text", ""),
                    "package": n.get("package", ""),
                    "bounds": tuple(int(g) for g in m.groups())}
    return {k: v for k, v in out.items() if seen[k] == 1}


def center(bounds):
    l, t, r, b = bounds
    return (l + r) // 2, (t + b) // 2


def plan_confirm_taps(nodes):
    """Taps for the 'Allow wireless debugging on this network?' dialog, or None when either the
    'always allow' checkbox or the positive button is missing (then nothing is tapped).
    The checkbox is tapped only if unchecked; the button last."""
    box, ok = nodes.get("android:id/alwaysUse"), nodes.get("android:id/button1")
    if not box or not ok:
        return None
    taps = [] if box["checked"] else [center(box["bounds"])]
    return taps + [center(ok["bounds"])]


def is_start_label(text):
    """True only for the droidVNC-NG toggle saying START/COMEÇAR; PARAR/STOP/anything else never."""
    return text.strip().lower() in START_LABELS


def plan_vnc_toggle_tap(nodes):
    """Center of the droidVNC-NG toggle iff it currently offers to START the server."""
    n = nodes.get(VNC_TOGGLE_ID)
    return center(n["bounds"]) if n and is_start_label(n["text"]) else None


def parse_wifi_ssid(text):
    """Current SSID from `cmd wifi status` ('connected to "x"' or 'SSID: "x"'), None if not connected."""
    m = re.search(r'connected to "([^"]*)"', text) or re.search(r'SSID: "([^"]*)"', text)
    return m.group(1) if m and m.group(1) != "<unknown ssid>" else None


def parse_wifi_bssid(text):
    """Current BSSID from `cmd wifi status` (`BSSID: aa:bb:...`), lower-cased, or None."""
    m = re.search(r"BSSID: ((?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2})", text)
    return m.group(1).lower() if m else None


def parse_pkg_signature(text):
    """`dumpsys package <pkg> | grep -A1 -i signatures` -> digest string of the signing certificate(s)
    (PackageSignatures `signatures:[hash,...]`), or None. Compared as an opaque pinned value."""
    m = re.search(r"signatures:\[([0-9a-fA-F, ]+)\]", text)
    if not m:
        return None
    return ",".join(sorted(x.strip().lower() for x in m.group(1).split(",") if x.strip())) or None


class Pins:
    """Trust-on-first-use store of package signing digests (/var/lib/cerberus-s10/pins.json)."""

    def __init__(self, path=None):
        self.path, self.pins = path, {}
        if path:
            try:
                with open(path) as f:
                    self.pins = {k: v for k, v in json.load(f).items() if isinstance(v, str)}
            except (OSError, ValueError, AttributeError):
                self.pins = {}

    def check(self, pkg, digest):
        """'ok' | 'new' (first sight: pinned now) | 'mismatch' | 'unknown' (digest unreadable)."""
        if not digest:
            return "unknown"
        known = self.pins.get(pkg)
        if known is None:
            self.pins[pkg] = digest
            if self.path:
                try:
                    write_atomic(self.path, self.pins, 0o600)
                except OSError:
                    pass
            return "new"
        return "ok" if known == digest else "mismatch"


def parse_perm_granted(text, perm):
    m = re.search(r"%s: granted=(true|false)" % re.escape(perm), text)
    return None if not m else m.group(1) == "true"


def parse_shizuku_running(text):
    return any("shizuku_server" in ln and "grep" not in ln for ln in text.splitlines())


def read_secret(path, rx=None):
    """Read a secret file (never logged). Returns the value if it matches `rx`, else None."""
    try:
        with open(path) as f:
            key = f.read(256).strip()
    except OSError:
        return None
    return key if (rx or KEY_RE).match(key) else None


def read_password(path):
    return read_secret(path, PASS_RE)


# ---------------------------------------------------------------- guardian: decisions (pure)
def plan_repairs(obs, cfg):
    """Decide repairs from an observation dict. Returns a list of actions:
    {"id", "why", "cmds": [argv...] | None, "script": str | None, "cooldown": bool}.
    A value of None in `obs` means 'could not be read': never repaired blindly.
    Only drift produces an action (read first, write only on drift)."""
    acts = []

    def act(aid, why, cmds=None, script=None, cooldown=False, fn=None, verify=None):
        acts.append({"id": aid, "why": why, "cmds": cmds, "script": script, "cooldown": cooldown, "fn": fn,
                     "verify": verify})

    if obs.get("stay_on") is not None and obs["stay_on"] != "7":
        act("stay_on", "stay_on_while_plugged_in=%r -> 7" % obs["stay_on"],
            [["settings", "put", "global", "stay_on_while_plugged_in", "7"]])
    if obs.get("wifi") is False:
        act("wifi", "Wi-Fi disabled -> svc wifi enable", [["svc", "wifi", "enable"]])
    if obs.get("adb_wifi") is not None and obs["adb_wifi"] != "1":
        act("adb_wifi", "adb_wifi_enabled=%r -> 1" % obs["adb_wifi"],
            [["settings", "put", "global", "adb_wifi_enabled", "1"]])
    if obs.get("vpn_app") is not None and obs["vpn_app"] != PKG_TAILSCALE:
        act("vpn_app", "always_on_vpn_app=%r -> %s" % (obs["vpn_app"], PKG_TAILSCALE),
            [["settings", "put", "secure", "always_on_vpn_app", PKG_TAILSCALE]])
    if obs.get("vpn_lockdown") is not None and obs["vpn_lockdown"] != "0":
        act("vpn_lockdown", "always_on_vpn_lockdown=%r -> 0" % obs["vpn_lockdown"],
            [["settings", "put", "secure", "always_on_vpn_lockdown", "0"]])
    if obs.get("ts_alive") is False:
        comp = obs.get("ts_activity")
        if comp and COMPONENT_RE.match(comp):
            act("tailscale_start", "%s not running -> am start" % PKG_TAILSCALE,
                [["am", "start", "-n", comp]], cooldown=True)
        else:
            act("tailscale_unresolved", "%s not running and launcher not resolved" % PKG_TAILSCALE)
    for pkg in IDLE_WHITELIST:
        if obs.get("idle", {}).get(pkg) is False:
            act("idle_" + pkg, "%s not in the doze whitelist" % pkg,
                [["dumpsys", "deviceidle", "whitelist", "+" + pkg]])
    if obs.get("projection") is not None and obs["projection"] != "allow":
        act("projection", "PROJECT_MEDIA=%r -> allow" % obs["projection"],
            [["appops", "set", PKG_VNC, "PROJECT_MEDIA", "allow"]])
    a11y = obs.get("a11y_services")
    if a11y is not None and not has_a11y_service(a11y, PKG_VNC):
        act("a11y_service", "accessibility service %s missing (append)" % VNC_INPUT_SERVICE,
            [["settings", "put", "secure", "enabled_accessibility_services",
              merge_a11y(a11y, VNC_INPUT_SERVICE)]])
    if obs.get("a11y_enabled") is not None and obs["a11y_enabled"] != "1":
        act("a11y_enabled", "accessibility_enabled=%r -> 1" % obs["a11y_enabled"],
            [["settings", "put", "secure", "accessibility_enabled", "1"]])
    ports = obs.get("ports")
    if ports is not None:
        if cfg["vnc_port"] not in ports:
            key, pw = obs.get("vnc_key"), obs.get("vnc_password")
            if key and pw:
                act("vnc_start", "droidVNC-NG not listening on :%d -> ACTION_START" % cfg["vnc_port"],
                    script=vnc_start_script(key, cfg["vnc_port"], cfg["vnc_iface"], pw), cooldown=True,
                    verify=PKG_VNC)
            elif key:
                # a key exists: never fall back to the unprotected UI start; refuse until a password exists too
                act("vnc_nopass", "droidVNC-NG down; access key set but /etc/cerberus-s10/vnc-password missing: "
                    "not starting without a VNC password")
            elif not cfg["allow_unprotected"]:
                act("vnc_off", "VNC desligado até rodar user-step-s10.sh --vnc-key (sem chave de acesso não há como "
                    "iniciar o droidVNC-NG com senha)")
            else:
                # explicit opt-in (S10_ALLOW_UNPROTECTED_VNC=1): press the app's own start button instead
                act("vnc_start", "droidVNC-NG not listening on :%d and no valid access key file -> UI start button "
                    "(VNC is UNPROTECTED until the key is set: user-step-s10.sh --vnc-key)" % cfg["vnc_port"],
                    cooldown=cfg["ui_cooldown_s"], fn="vnc_ui", verify=PKG_VNC)
        exposed = [a for a in ports.get(cfg["vnc_port"], ()) if a not in LOOPBACK]
        if exposed and not (obs.get("vnc_key") and obs.get("vnc_password")):
            act("vnc_exposed_stop", "droidVNC-NG listens on %s without a configured VNC password -> force-stop"
                % ",".join(sorted(exposed)), [["am", "force-stop", PKG_VNC]])
        if cfg["ssh_port"] not in ports:
            # RUN_COMMAND is refused for the shell uid: open Termux (its ~/.bashrc hook starts sshd + guardian)
            act("termux_start", "Termux sshd not listening on :%d -> open Termux" % cfg["ssh_port"],
                cooldown=cfg["ui_cooldown_s"], fn="termux_ui")
    for perm, granted in sorted((obs.get("vnc_perms") or {}).items()):
        if granted is False:
            act("grant_" + perm.rsplit(".", 1)[1], "%s not granted to droidVNC-NG" % perm,
                [["pm", "grant", PKG_VNC, perm]])
    if obs.get("shizuku") is False:
        act("shizuku", "shizuku_server not running -> libshizuku.so", [[SHIZUKU_START]], cooldown=True,
            verify=PKG_SHIZUKU)
    return acts


def vnc_start_script(key, port, iface, password=None):
    """Script fed to `adb shell` over stdin so the key/password never appear in an argv on the atheron."""
    if not KEY_RE.match(key):
        raise ValueError("invalid access key")
    if password is not None and not PASS_RE.match(password):
        raise ValueError("invalid VNC password")
    ns = PKG_VNC + "."
    parts = ["am", "start-foreground-service", "-n", VNC_SERVICE,
             "-a", ns + "ACTION_START",
             "--es", ns + "EXTRA_ACCESS_KEY", "'%s'" % key,
             "--ei", ns + "EXTRA_PORT", str(int(port))]
    if password is not None:
        parts += ["--es", ns + "EXTRA_PASSWORD", "'%s'" % password]
    if iface:
        if not re.match(r"^[A-Za-z0-9_.-]+$", iface):
            raise ValueError("invalid interface")
        parts += ["--es", ns + "EXTRA_INTERFACE", iface]
    return " ".join(parts) + "\nexit\n"


class Transitions:
    """Logs a path going up/down once (and its first observation), not every cycle."""

    def __init__(self):
        self.last = {}

    def update(self, name, ok):
        if ok is None:
            return None
        prev = self.last.get(name)
        self.last[name] = ok
        if prev is None or prev != ok:
            return "path %s: %s" % (name, "up" if ok else "down")
        return None


class AdbRecovery:
    """Exponential backoff for adb restarts when the S10 is not 'device'.
    `adb reconnect` at 30 s, 60 s, 120 s ... capped at `cap`; kill-server/start-server
    at most every `restart_every` seconds and only after a reconnect failed."""

    def __init__(self, base=30.0, cap=300.0, restart_every=300.0):
        self.base, self.cap, self.restart_every = base, cap, restart_every
        self.reset()

    def reset(self):
        self.fails = 0
        self.next_try = 0.0
        self.last_restart = None

    def step(self, estado, now):
        if estado == "device":
            self.reset()
            return []
        if now < self.next_try:
            return []
        acts = []
        if self.fails >= 1 and (self.last_restart is None or now - self.last_restart >= self.restart_every):
            acts.append("restart-server")
            self.last_restart = now
        else:
            acts.append("reconnect-offline" if estado == "offline" else "reconnect")
        self.next_try = now + min(self.cap, self.base * (2 ** self.fails))
        self.fails += 1
        return acts


# ---------------------------------------------------------------- guardian: IO
def tcp_probe(host, port, timeout=2.0, banner=None, connect=socket.create_connection):
    """True if a TCP connection succeeds (and, if `banner`, the peer starts with it)."""
    try:
        with connect((host, port), timeout) as s:
            if banner:
                s.settimeout(timeout)
                return s.recv(len(banner)) == banner
            return True
    except (OSError, ValueError):
        return False


def ping_probe(ip, run=None):
    run = run or default_run
    rc, _ = run(["ping", "-c1", "-W2", ip], timeout=6)
    return rc == 0


def guard_config(env):
