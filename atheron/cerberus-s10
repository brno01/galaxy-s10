class Guardian:
    """Enforces the S10 settings and tracks the health of the three access paths.
    `run(cmd, input_text=None, timeout=15) -> (rc, stdout)` and `probes` are injectable."""

    def __init__(self, run, cfg, adb="adb", serial=None, probes=None, logf=None, read_key=read_secret,
                 sleep=time.sleep, read_pass=read_password, server_args=()):
        self.run, self.cfg, self.adb, self.serial = run, cfg, adb, serial
        self.probes = probes or {
            "ping": ping_probe,
            "tcp": tcp_probe,
        }
        self.logf = logf or (lambda m: None)
        self.read_key = read_key
        self.read_pass = read_pass
        self.server_args = list(server_args)
        self.pins = Pins(cfg.get("pins_file"))
        self.sleep = sleep
        self.last_ativa = None
        self.trans = Transitions()
        self.recovery = AdbRecovery()
        self.last_try = {}
        self.once = set()
        self.reparos = []
        self.last_ip = None
        self.last_port = None

    # -- helpers
    def log(self, msg):
        self.logf(msg)

    def warn_once(self, key, msg):
        if key not in self.once:
            self.once.add(key)
            self.log(msg)

    def _shell(self, serial, args, input_text=None, timeout=15):
        cmd = [self.adb, "-s", serial, "shell"] + list(args)
        if input_text is None:
            return self.run(cmd)
        return self.run(cmd, input_text=input_text, timeout=timeout)

    def seed(self, previous):
        """Reuse the last published ip/port after a restart (estado.json lives in /run)."""
        try:
            aw = previous["caminhos"]["adb_sem_fio"]
            self.last_ip, self.last_port = aw.get("ip_lan") or aw.get("ip"), aw.get("porta")
        except (KeyError, TypeError):
            pass

    # -- observation
    def observe(self, serial):
        def get(args):
            rc, out = self._shell(serial, args)
            return (out if rc == 0 else None)

        def setting(ns, name):
            out = get(["settings", "get", ns, name])
            return None if out is None else parse_setting(out)

        obs = {
            "stay_on": setting("global", "stay_on_while_plugged_in"),
            "adb_wifi": setting("global", "adb_wifi_enabled"),
            "vpn_app": setting("secure", "always_on_vpn_app"),
            "vpn_lockdown": setting("secure", "always_on_vpn_lockdown"),
            "a11y_services": setting("secure", "enabled_accessibility_services"),
            "a11y_enabled": setting("secure", "accessibility_enabled"),
        }
        out = get(["cmd", "wifi", "status"])
        obs["wifi"] = None if out is None else parse_wifi_status(out)
        # pidof exits 1 when not running, so only rc 0/1 with empty output counts as "not alive"
        rc, out = self._shell(serial, ["pidof", PKG_TAILSCALE])
        obs["ts_alive"] = parse_pid(out) if rc in (0, 1) else None
        if obs["ts_alive"] is False:
            out = get(["cmd", "package", "resolve-activity", "--brief", PKG_TAILSCALE])
            obs["ts_activity"] = parse_resolve_activity(out or "")
        out = get(["dumpsys", "deviceidle", "whitelist"])
        obs["idle"] = {} if out is None else {p: parse_whitelist(out, p) for p in IDLE_WHITELIST}
        out = get(["appops", "get", PKG_VNC, "PROJECT_MEDIA"])
        obs["projection"] = None if out is None else (parse_appop(out, "PROJECT_MEDIA") or "default")
        out = get(["ss", "-ltn"])
        obs["ports"] = None if (out is None or not out.strip()) else parse_listening(out)
        out = get(["pm", "path", PKG_SHIZUKU])
        if out is not None and "package:" in out:
            ps = get(["ps -A | grep shizuku_server"])
            obs["shizuku"] = parse_shizuku_running(ps or "")
        else:
            obs["shizuku"] = None       # not installed: nothing to start
        out = get(["dumpsys package %s | grep -E '_EXTERNAL_STORAGE: granted'" % PKG_VNC])
        obs["vnc_perms"] = {p: parse_perm_granted(out or "", p) for p in VNC_PERMS}
        obs["tls_port"] = parse_tls_port(get(["getprop", "service.adb.tls.port"]) or "")
        obs["wifi_ip"] = parse_wifi_ip(get(["ip", "-f", "inet", "addr", "show", self.cfg["wifi_iface"]]) or "")
        return obs

    def _cooldown_ok(self, aid, now, cooldown=None):
        last = self.last_try.get(aid)
        if last is not None and now - last < (self.cfg["cooldown_s"] if cooldown is None else cooldown):
            return False
        self.last_try[aid] = now
        return True

    def verify_pkg(self, serial, pkg):
        """Trust-on-first-use pin of the package signing digest before handing it secrets or starting it."""
        rc, out = self._shell(serial, ["dumpsys package %s | grep -i -A1 signatures" % pkg])
        digest = parse_pkg_signature(out) if rc == 0 else None
        verdict = self.pins.check(pkg, digest)
        if verdict == "new":
            self.log("pinned signing digest of %s (first use)" % pkg)
        elif verdict == "mismatch":
            self.warn_once("pin_" + pkg, "WARNING signing certificate of %s CHANGED: refusing to use it "
                           "(remove its entry from the pins file only if the update was yours)" % pkg)
        elif verdict == "unknown":
            self.warn_once("pinunk_" + pkg, "WARNING cannot read the signing digest of %s: refusing" % pkg)
        return verdict in ("ok", "new")

    # -- UI-driven repairs (no secrets: they press the apps' own buttons)
    def _focus(self, serial):
        rc, out = self._shell(serial, ["dumpsys window | grep mCurrentFocus; dumpsys activity activities | grep -m1 mResumedActivity"])
        return parse_focus(out) if rc == 0 else None

    def _ui_nodes(self, serial, package):
        self._shell(serial, ["uiautomator", "dump", UI_DUMP])
        rc, xml_text = self._shell(serial, ["head -c %d %s" % (MAX_XML, UI_DUMP)])
        self._shell(serial, ["rm", "-f", UI_DUMP])
        return parse_ui_nodes(xml_text, package) if rc == 0 else {}

    def _tap(self, serial, xy):
        self._shell(serial, ["input", "tap", str(xy[0]), str(xy[1])])

    def _listening(self, serial, port):
        rc, out = self._shell(serial, ["ss", "-ltn"])
        return rc == 0 and port in parse_listening(out)

    def vnc_ui(self, serial, now):
        """Open droidVNC-NG and press START (only if the toggle says so; MediaProjection consent is
        pre-granted by appops, never tapped here), then go HOME and re-check the port."""
        self._shell(serial, ["am", "start", "-n", PKG_VNC + "/.MainActivity"])
        self.sleep(2)
        focus = self._focus(serial)
        if not (focus or "").startswith(VNC_MAIN_PREFIX):
            self._shell(serial, ["input", "keyevent", "3"])
            return "droidVNC-NG not in focus (%s); nothing tapped" % focus
        tap, seen = None, False
        for attempt in range(3):                      # the button may be below the fold: up to 2 swipes
            nodes = self._ui_nodes(serial, PKG_VNC)
            seen = VNC_TOGGLE_ID in nodes
            tap = plan_vnc_toggle_tap(nodes)
            if seen or attempt == 2:
                break
            self._shell(serial, ["input", "swipe", "360", "1300", "360", "300", "300"])
            self.sleep(1)
        if tap is not None:
            self._tap(serial, tap)
            what = "tapped START"
        else:
            what = "toggle not offering START (%s)" % ("seen" if seen else "not found")
        self._shell(serial, ["input", "keyevent", "3"])
        self.sleep(5)
        return "%s; port %s" % (what, "up" if self._listening(serial, self.cfg["vnc_port"]) else "still down")

    def termux_ui(self, serial, now):
        """Open Termux: its ~/.bashrc hook (bootstrap.sh) starts sshd and the phone guardian."""
        rc, out = self._shell(serial, ["cmd", "package", "resolve-activity", "--brief", PKG_TERMUX])
        comp = parse_resolve_activity(out) if rc == 0 else None
        self._shell(serial, ["am", "start", "-n", comp or TERMUX_ACTIVITY])
        self.sleep(5)
        up = self._listening(serial, self.cfg["ssh_port"])
        self._shell(serial, ["input", "keyevent", "3"])
        return "Termux opened; sshd %s" % ("up" if up else "still down")

    def logcat_port(self, serial):
        rc, out = self._shell(serial, ["logcat -d -b all | grep -o 'Received tls port=[0-9]*' | tail -1"])
        return parse_logcat_tls_port(out) if rc == 0 else None

    def regenerate_port(self, serial, now):
        """The log line rotated out of the buffer and no other source knows the port: toggle wireless
        debugging so adbd logs a fresh one (drops any wireless session; at most once per 10 min)."""
        if not self.cfg["repair"] or not self._cooldown_ok("adb_wifi_port", now, self.cfg["regen_cooldown_s"]):
            return None
        self._shell(serial, ["settings", "put", "global", "adb_wifi_enabled", "0"])
        self.sleep(2)
        self._shell(serial, ["settings", "put", "global", "adb_wifi_enabled", "1"])
        self.sleep(3)
        p = self.logcat_port(serial)
        self.log("REPAIR adb_wifi_port: no TLS port known, toggled wireless debugging (port %s)" % (p or "not found"))
        self.reparos.append({"epoch": int(now), "id": "adb_wifi_port", "rc": 0})
        if p:
            self.last_port = p
        return p

    def discover_tls(self, serial):
        """Port of the wireless-debugging service (random, only advertised on the LAN by mDNS; the
        `service.adb.tls.port` property is empty on this build): the atheron's own adb server first,
        then avahi-browse. Returns (ip, port) or None."""
        want = self.cfg["mdns_serial"] or serial
        rc, out = self.run([self.adb, "mdns", "services"])
        found = parse_mdns_services(out, want) if rc == 0 else []
        if not found:
            rc, out = self.run(["avahi-browse", "-rpt", "_adb-tls-connect._tcp"])
            found = parse_avahi_tls(out, want) if rc == 0 else []
        return found[0] if found else None

    # -- repairs
    def repair(self, serial, obs, now):
        if "vnc_key" not in obs:
            obs["vnc_key"] = self.read_key(self.cfg["key_file"])
            obs["vnc_password"] = self.read_pass(self.cfg["pass_file"])
        done = []
        for a in plan_repairs(obs, self.cfg):
            if a["id"] in ("tailscale_unresolved", "vnc_nopass", "vnc_off"):
                self.warn_once(a["id"], "WARNING %s" % a["why"])
                continue
            if not self.cfg["repair"]:
                self.warn_once("dry_" + a["id"], "drift (repair off): %s" % a["why"])
                continue
            if a["cooldown"] and not self._cooldown_ok(a["id"], now, None if a["cooldown"] is True else a["cooldown"]):
                continue
            if a["verify"] and not self.verify_pkg(serial, a["verify"]):
                continue
            if a["fn"]:
                if a["fn"] == "vnc_ui":
                    self.warn_once("vnc_nokey", "WARNING %s" % a["why"])
                res = getattr(self, a["fn"])(serial, now)
                self.log("REPAIR %s: %s (%s)" % (a["id"], a["why"], res))
                done.append(a["id"])
                self.reparos.append({"epoch": int(now), "id": a["id"], "rc": 0})
                continue
            rc = 0
            for cmd in a["cmds"] or []:
                rc, _ = self._shell(serial, cmd)
            if a["script"] is not None:
                rc, _ = self._shell(serial, [], input_text=a["script"])
            self.log("REPAIR %s: %s (rc=%s)" % (a["id"], a["why"], rc))
            if a["id"] == "adb_wifi":
                self.check_stuck(serial, now)
            done.append(a["id"])
            self.reparos.append({"epoch": int(now), "id": a["id"], "rc": rc})
        self.reparos = self.reparos[-20:]
        return done

    def check_stuck(self, serial, now):
        """Android turns wireless debugging off again on networks not yet confirmed (after every reboot
        it asks 'Allow wireless debugging on this network?'): accept that dialog over USB, then re-check."""
        self.sleep(self.cfg["stick_s"])
        if self._adb_wifi_on(serial):
            self.once.discard("stuck")
            return True
        if self.confirm_wifi_dialog(serial, now) and self._adb_wifi_on(serial):
            self.once.discard("stuck")
            return True
        self.warn_once("stuck", "WARNING rede não confiável para depuração sem fio "
                       "(adb_wifi_enabled voltou a 0): marque 'Sempre permitir nesta rede'")
        return False

    def _adb_wifi_on(self, serial):
        rc, out = self._shell(serial, ["settings", "get", "global", "adb_wifi_enabled"])
        return not (rc == 0 and parse_setting(out) != "1")

    def confirm_wifi_dialog(self, serial, now):
        """Tap 'always allow' + 'Permitir' only when the focused window is exactly the wireless-debugging
        confirmation and both widgets were found in a uiautomator dump. At most once per cooldown."""
        rc, out = self._shell(serial, ["dumpsys window | grep mCurrentFocus; dumpsys activity activities | grep -m1 mResumedActivity"])
        if rc != 0 or parse_focus(out) != WIFI_CONFIRM_FOCUS:
            return False
        if not self._cooldown_ok("adb_wifi_confirm", now):
            return False
        rc, st = self._shell(serial, ["cmd", "wifi", "status"])
        ssid = parse_wifi_ssid(st) if rc == 0 else None
        bssid = parse_wifi_bssid(st) if rc == 0 else None
        if ssid != self.cfg["home_ssid"] or bssid != self.cfg["home_bssid"]:
            self.warn_once("ssid", "WARNING wireless debugging dialog on network %r (%s), not the home network "
                           "%r (%s): not accepting it" % (ssid, bssid, self.cfg["home_ssid"], self.cfg["home_bssid"]))
            return False
        nodes = self._ui_nodes(serial, SYSTEMUI_PKG)
        msg = nodes.get("android:id/message")
        if msg and ssid not in [ln.strip().strip('"') for ln in msg["text"].splitlines()]:  # the dialog shows "ssid" quoted
            self.warn_once("ssid_dialog", "WARNING dialog text does not name the home network exactly: not tapping")
            return False
        taps = plan_confirm_taps(nodes)
        if taps is None:
            self.log("WARNING wireless debugging dialog in focus but its widgets were not found; not tapping")
            return False
        if self._focus(serial) != WIFI_CONFIRM_FOCUS:       # focus may have moved while we dumped the UI
            self.log("WARNING focus left the wireless debugging dialog before tapping; not tapping")
            return False
        for x, y in taps:
            self._shell(serial, ["input", "tap", str(x), str(y)])
        self.log("REPAIR adb_wifi_confirm: tapped %d point(s) on the wireless debugging dialog" % len(taps))
        self.reparos.append({"epoch": int(now), "id": "adb_wifi_confirm", "rc": 0})
        self.sleep(1)
        return True

    def recover_adb(self, estado, now):
        for a in self.recovery.step(estado, now):
            if a == "restart-server":
                self.log("adb recovery: kill-server + start-server (device %s)" % estado)
                self.run([self.adb, "kill-server"])
                self.run([self.adb] + self.server_args + ["start-server"])
            else:
                self.log("adb recovery: %s (device %s)" % (a.replace("-", " "), estado))
                self.run([self.adb] + a.split("-"))

    # -- one cycle
    def cycle(self, snap, now):
        """Mutates `snap` (adds caminhos/guardiao) and returns the list of log lines emitted."""
        lines = []
        old_log = self.logf
        self.logf = lambda m: (lines.append(m), old_log(m))
        try:
            return self._cycle(snap, now, lines)
        finally:
            self.logf = old_log

    def _cycle(self, snap, now, lines):
        cfg = self.cfg
        usb = snap["estado"] == "device"
        obs = None
        self.recover_adb(snap["estado"], now)
        if usb:
            obs = self.observe(snap["serial"])
            done = self.repair(snap["serial"], obs, now)
            if obs["wifi_ip"]:
                self.last_ip = obs["wifi_ip"]
            on = obs["adb_wifi"] == "1"
            if "adb_wifi" in done:
                on = self._adb_wifi_on(snap["serial"])
            if obs["adb_wifi"] is not None:
                self.last_ativa = on
            if obs["tls_port"]:
                self.last_port = obs["tls_port"]
            elif not on:
                self.last_port = None
            if on:
                # primary source: adbd logs "Received tls port=N" over USB (mDNS is invisible from the atheron)
                p = self.logcat_port(snap["serial"])
                if p:
                    self.last_port = p
                    obs["tls_port"] = obs["tls_port"] or p
        if self.last_ativa is not False and not (usb and obs and obs["tls_port"]):
            found = self.discover_tls(snap["serial"])
            if found:
                if not (usb and obs and obs["wifi_ip"]):
                    self.last_ip = found[0]
                self.last_port = found[1]
        if usb and self.last_ativa and self.last_port is None:
            self.regenerate_port(snap["serial"], now)
        ip, port = self.last_ip, self.last_port
        tcp, ping = self.probes["tcp"], self.probes["ping"]
        tail_ok = None
        if ip and port:
            tail_ok = bool(tcp(cfg["tailnet_ip"], port))
            aw_ok = tail_ok or bool(tcp(ip, port))
        elif usb and self.last_ativa:
            aw_ok = None   # enabled, but this One UI build does not expose the TLS port: nomad finds it via mDNS
        else:
            aw_ok = False if usb else None
        if cfg["ts_probe"] == "off":
            ts_ok = None
        else:
            ts_ok = bool(ping(cfg["tailnet_ip"]))
        ssh_ok = tcp(cfg["tailnet_ip"], cfg["ssh_port"], banner=b"SSH-")
        ports = obs["ports"] if obs else None
        vnc_ok = None if ports is None else cfg["vnc_port"] in ports
        loopback = None
        if vnc_ok:
            loopback = all(a in LOOPBACK for a in ports[cfg["vnc_port"]])
            if not loopback:
                self.warn_once("vnc_exposed", "WARNING VNC :%d listens on a non-loopback address" % cfg["vnc_port"])
        snap["caminhos"] = {
            "usb": {"ok": usb, "estado": snap["estado"]},
            "adb_sem_fio": {"ip_lan": ip, "porta": port, "ip_tailnet": cfg["tailnet_ip"], "ok": aw_ok,
                            "ok_tailnet": tail_ok, "ativa": self.last_ativa},
            "tailscale": {"ok": ts_ok, "ip": cfg["tailnet_ip"]},
            "ssh_termux": {"ok": ssh_ok, "porta": cfg["ssh_port"]},
            "vnc": {"ok": vnc_ok, "porta": cfg["vnc_port"], "loopback": loopback},
        }
        shizuku = None if obs is None else obs.get("shizuku")
        snap["guardiao"] = {"reparos": list(self.reparos), "reparar": cfg["repair"],
                            "shizuku": {"ok": shizuku}}
        for name, ok in (("shizuku", shizuku), ("usb", usb), ("adb_sem_fio", aw_ok), ("tailscale", ts_ok),
                         ("ssh_termux", ssh_ok), ("vnc", vnc_ok)):
            msg = self.trans.update(name, ok)
            if msg:
                self.log(msg)
        return lines


def public_summary(snap, alerts, now):
    """Whitelisted summary for dashboards (the private estado.json holds IPs, ports and the serial).
    Built field by field: never copy or filter the full snapshot."""
    bat = snap.get("bateria")
    bateria = None
    if bat:
        bateria = {"nivel": bat.get("nivel"), "status": bat.get("status"),
                   "temperatura_c": bat.get("temperatura_c"), "saude": bat.get("saude")}
    caminhos = snap.get("caminhos") or {}
    paths = {}
    for name in ("usb", "adb_sem_fio", "tailscale", "ssh_termux", "vnc"):
        entry = caminhos.get(name)
        ok = entry.get("ok") if isinstance(entry, dict) else None
        paths[name] = ok if isinstance(ok, bool) else None
    avisos = []
    if bat:
        t = bat.get("temperatura_c")
        if t is not None and t >= alerts.temp_max:
            avisos.append("temperatura")
        if (bat.get("nivel") or 0) >= 100 and alerts.full_since is not None \
                and now - alerts.full_since >= alerts.full_s:
            avisos.append("carga_cheia")
    return {"versao": 1, "gerado_em": int(now), "bateria": bateria, "caminhos": paths, "avisos": avisos}


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    env = os.environ
    adb = env.get("S10_ADB", "adb")
    serial = env.get("S10_SERIAL") or None
    interval = float(env.get("S10_INTERVAL", "30"))
    path = env.get("S10_STATE", "/run/cerberus-s10/estado.json")
    alerts = Alerts(float(env.get("S10_TEMP_MAX", "45")), float(env.get("S10_FULL_HOURS", "24")))
    public_path = env.get("S10_PUBLIC", "/run/cerberus-s10-publico/resumo.json")
    sock = env.get("S10_ADB_SOCKET", "/run/cerberus-s10/adb.sock")
    server_args = ["-L", "localfilesystem:" + sock] if sock else []
    if sock:
        os.environ["ADB_SERVER_SOCKET"] = "localfilesystem:" + sock   # every adb client below talks to it
    cfg = guard_config(env)
    if not cfg["tailnet_ip"]:
        log("S10_TAILNET_IP is not set: copy atheron/s10.env.example to /etc/default/cerberus-s10 "
            "(the installer does it from atheron/s10.local.env) and fill in the real values")
        return 2
    guardian = Guardian(default_run, cfg, adb, serial, logf=lambda m: log(m),
                        server_args=server_args)
    try:
        with open(path) as f:
            guardian.seed(json.load(f))
    except (OSError, ValueError):
        pass
    keys = env.get("ADB_VENDOR_KEYS")
    if keys:
        try:
            os.makedirs(keys, mode=0o700, exist_ok=True)
        except OSError as e:
            log("warning: cannot create %s: %s" % (keys, e))
    once = "--once" in argv
    while True:
        try:
            snap = collect(default_run, adb, serial, server_args=server_args)
            if sock:
                try:
                    os.chmod(sock, 0o660)    # group cerberus-s10 (tunnel user) may connect; nobody else
                except OSError:
                    pass
            try:
                guardian.cycle(snap, snap["epoch"])
            except Exception as e:  # a guardian bug must not stop the estado.json
                log("guardian error: %r" % (e,))
            write_atomic(path, snap, 0o640)
            try:
                write_atomic(public_path, public_summary(snap, alerts, snap["epoch"]), 0o644)
            except Exception as e:  # the public summary must never stop the estado.json
                log("public summary error: %r" % (e,))
            for m in alerts.evaluate(snap, snap["epoch"]):
                log("WARNING " + m)
        except Exception as e:  # keep the loop alive; systemd Restart is the backstop
            log("error: %r" % (e,))
            if once:
                return 1
        if once:
            return 0
        time.sleep(interval)


if __name__ == "__main__":
    sys.exit(main())
