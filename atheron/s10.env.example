# Site values for the cerberus-s10 service (systemd EnvironmentFile format: KEY=value, no quotes, no export).
# Copy to atheron/s10.local.env (git-ignored) and fill in; the installer merges it into /etc/default/cerberus-s10.
# Documentation values below (RFC 5737 / CGNAT range); replace with the real ones.

# REQUIRED: tailnet IP of the phone (ping + ssh banner probes); without it the service refuses to start
S10_TAILNET_IP=100.64.0.10
# Home Wi-Fi: the wireless-debugging dialog is only accepted on exactly this SSID AND BSSID (empty = never accepted)
S10_HOME_SSID=homenet
S10_HOME_BSSID=02:00:00:00:00:01
# Serial used to find the phone's wireless-debugging service in mDNS (empty = the serial of the USB device)
S10_MDNS_SERIAL=EXAMPLESERIAL
